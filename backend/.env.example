# Copy this file to .env and fill in your API key
# Never commit the actual .env file

# Google Gemini API Key (required)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Qdrant Vector Store configuration
# Leave QDRANT_URL empty to use local embedded on-disk mode (default: data/qdrant_storage)
# For Docker Compose / Remote Qdrant, set QDRANT_URL=http://qdrant:6333 (or http://localhost:6333)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=resume_collection
